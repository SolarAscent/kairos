NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://life:life@localhost:5432/life_decision
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_TTL_SECONDS=1200
REFRESH_TOKEN_TTL_DAYS=30
WECHAT_MOCK_LOGIN=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# qwen is the recommended domestic provider. Missing key keeps the server available,
# but capabilities are disabled and captures cannot be parsed by a real model.
MODEL_PROVIDER=qwen
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
QWEN_TEXT_MODEL=qwen3.7-flash-2026-07-15
QWEN_VISION_MODEL=qwen3.7-flash-2026-07-15
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
# Optional GLM text/vision alternative (voice remains Qwen-only).
GLM_API_KEY=
GLM_TEXT_MODEL=glm-4.7-flash
GLM_VISION_MODEL=glm-4.6v-flash
DEMO_ORIGIN=http://localhost:5173

# Optional server-only verified location / walking-route integration
TENCENT_LBS_KEY=
TENCENT_LBS_SECRET=
