.life-stack { margin:36rpx 0 54rpx; }
.deck-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:22rpx; }
.deck-kind { color:#233C35; font-family:'Songti SC', serif; font-size:34rpx; font-weight:500; }
.deck-link { margin:0 !important; padding:0 8rpx; width:auto !important; font-size:24rpx; line-height:52rpx; color:#72827B; }
.deck-stage { position:relative; height:510rpx; }
.deck-layer { position:absolute; height:454rpx; border-radius:28rpx; border:2rpx solid #D4DFD7; }
.deck-layer-back { left:28rpx; right:28rpx; bottom:0; background:#DAE3DC; }
.deck-layer-middle { left:14rpx; right:14rpx; bottom:12rpx; background:#E7EDE8; }
.deck-swiper { position:relative; height:482rpx; width:100%; }
.deck-card { height:100%; width:100%; padding:32rpx; box-sizing:border-box; border-radius:28rpx; background:#FFFFFF; border:2rpx solid #E1E8E2; display:flex; flex-direction:column; }
.deck-copy { flex:1; min-height:0; overflow:hidden; }
.deck-preference { display:block; color:#567461; font-size:21rpx; margin-bottom:10rpx; }
.deck-title { display:block; color:#233C35; font-size:34rpx; line-height:1.5; font-weight:500; }
.deck-summary { display:block; color:#72827B; font-size:26rpx; line-height:1.7; margin-top:18rpx; }
.deck-meta { display:block; margin-top:16rpx; color:#72827B; font-size:22rpx; line-height:1.7; }
.deck-ratings { display:flex; align-items:center; margin-top:20rpx; gap:12rpx; }
.rating-button { width:auto !important; margin:0 !important; padding:0 16rpx; border-radius:22rpx; font-size:23rpx; line-height:66rpx; color:#72827B; background:#F5F7F6; }
.rating-button.rated-like { color:#233C35; background:#DEE7DF; }
.rating-button.rated-dislike { color:#765E55; background:#EDE6E0; }
.deck-position { margin-left:auto; font-size:21rpx; color:#72827B; }
.deck-navigation { display:flex; align-items:center; justify-content:space-between; margin-top:12rpx; }
.deck-hint { color:#72827B; font-size:22rpx; line-height:1.7; }
.deck-arrows { display:flex; gap:8rpx; }
.deck-arrow { width:60rpx !important; margin:0 !important; padding:0; line-height:60rpx; color:#567461; font-size:30rpx; border-radius:50%; }
.deck-load { width:auto !important; margin:14rpx auto 0; color:#567461; font-size:25rpx; line-height:60rpx; }
.deck-status { color:#72827B; font-size:25rpx; line-height:1.8; padding:30rpx 0; }
