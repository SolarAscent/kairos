page { background: #F5F7F6; color: #233C35; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; font-size: 30rpx; }
view, scroll-view, button, textarea { box-sizing: border-box; }
button { margin: 0; padding: 0; font: inherit; background: transparent; color: inherit; border-radius: 0; }
button::after { border: 0; }
button[disabled] { opacity: .5; color: #72827B; }
text { display: block; }
