<view class="detail-screen journal-page {{reduceMotion ? 'reduce-motion' : ''}}" style="padding-top: {{topInset}}px; padding-bottom: {{bottomInset}}px;">
  <view class="detail-header"><button class="icon-button" bindtap="goBack" aria-label="返回">‹</button><text class="header-title">{{view ? view.kindLabel + '详情' : '生活记录'}}</text><button wx:if="{{detail}}" class="edit-button" bindtap="edit" disabled="{{busy}}">编辑</button></view>
  <view class="detail-body">
    <view wx:if="{{!loggedIn}}" class="paper-card login-card"><text>登录后查看这条生活记录。</text><button class="primary-button" bindtap="login">去登录</button></view>
    <text wx:if="{{loading}}" class="page-message">正在翻开这条记录…</text>
    <view wx:if="{{error}}" class="error-card"><text>{{error}}</text><button wx:if="{{!detail && loggedIn}}" class="secondary-button" bindtap="loadDetail">重试</button></view>
    <block wx:if="{{detail && view}}">
      <view class="status-row"><text class="status-stamp">{{view.statusLabel}}</text><text class="record-type">{{view.kindLabel}}</text></view>
      <view class="entry-sheet paper-card {{detail.kind === 'ASSET' ? 'ticket-sheet' : ''}}">
        <view class="tape" aria-hidden="true"></view>
        <view wx:if="{{heroImagePath && (detail.kind === 'PLACE' || detail.kind === 'ASSET')}}" class="polaroid"><image class="entry-image" src="{{heroImagePath}}" mode="aspectFill" bindtap="previewHero"/><text class="photo-caption">收录原图</text></view>
        <text class="entry-title">{{detail.title}}</text>
        <text wx:if="{{detail.summary}}" class="entry-summary">{{detail.summary}}</text>
        <view wx:if="{{detail.kind === 'DESIRE' || detail.kind === 'OPEN_LOOP'}}" class="entry-duration"><text>已收录 {{view.elapsedDays}} 天</text><text>{{view.sourceCount}} 条原始来源</text></view>
        <view wx:if="{{heroImagePath && detail.kind !== 'PLACE' && detail.kind !== 'ASSET'}}" class="polaroid journal-photo"><image class="entry-image" src="{{heroImagePath}}" mode="aspectFill" bindtap="previewHero"/><text class="photo-caption">收录原图</text></view>
        <view wx:if="{{detail.kind === 'ASSET'}}" class="ticket-facts"><view class="fact-row"><text>有效时间</text><text>{{view.deadline}}</text></view><view class="fact-row"><text>适用门店</text><text>{{view.placeName}}</text></view><view class="fact-row"><text>门店地址</text><text>{{view.placeAddress}}</text></view><button wx:if="{{ticketVerificationAvailable}}" class="secondary-button" bindtap="editStore" disabled="{{busy}}">核对适用门店</button></view>
        <view wx:if="{{detail.kind === 'ASSET'}}" class="ticket-stub"><view class="tear-line" aria-hidden="true"></view><text class="stub-label">原券凭证码</text><text class="voucher-code">{{view.ticketCode}}</text><text class="stub-note">{{view.ticketCode === '待补充' ? '未收录券码，请打开来源核对原券。' : '仅展示已收录信息，请以原券及门店核验为准。'}}</text><button wx:if="{{ticketVerificationAvailable}}" class="primary-button" bindtap="verifyTicket" disabled="{{busy}}">核验票券</button></view>
      </view>
      <view wx:if="{{view.hasPlaceCandidate || detail.selectedDestination || detail.verifiedDestination}}" class="place-sheet paper-card"><text class="section-title">地址与地点</text><view class="fact-row"><text>地点</text><text>{{view.placeName}}</text></view><view class="fact-row"><text>地址</text><text>{{view.placeAddress}}</text></view><text class="place-note">{{detail.verifiedDestination ? '已核对坐标，可在微信地图查看。' : detail.selectedDestination ? '已保存你确认的地图选点；门店与路线尚未核验。' : '地点待补充；选择后需明确确认才会保存。'}}</text><button wx:if="{{detail.verifiedDestination || detail.selectedDestination || detail.status === 'ACTIVE'}}" class="primary-button" bindtap="openMap" disabled="{{busy || mapPickerBusy}}">{{detail.verifiedDestination || detail.selectedDestination ? '在地图查看' : mapPickerBusy ? '正在打开选点…' : '选择地图地点'}}</button><button wx:if="{{detail.status === 'ACTIVE' && (detail.verifiedDestination || detail.selectedDestination)}}" class="secondary-button" bindtap="choosePlace" disabled="{{busy || mapPickerBusy}}">重新选择地点</button><text wx:if="{{detail.status !== 'ACTIVE' && !detail.verifiedDestination && !detail.selectedDestination}}" class="place-note">恢复为等待发生后可补充地图地点。</text><text wx:if="{{locationNotice}}" class="place-note">{{locationNotice}}</text><view wx:if="{{mapSelection}}"><text class="place-note">待确认：{{mapSelection.name}} · {{mapSelection.address}}</text><button class="primary-button" bindtap="confirmMapSelection" disabled="{{busy}}">确认保存这个地点</button><button class="secondary-button" bindtap="cancelMapSelection" disabled="{{busy}}">取消选择</button></view></view>
      <view class="source-sheet paper-card"><text class="section-title">记录源流</text><view class="timeline-row"><view class="timeline-dot"></view><view><text class="timeline-label">记录时间</text><text class="timeline-value">{{view.savedDate}}</text></view></view><view wx:if="{{view.updatedDate !== view.savedDate}}" class="timeline-row"><view class="timeline-dot"></view><view><text class="timeline-label">最近更新</text><text class="timeline-value">{{view.updatedDate}}</text></view></view><button wx:for="{{view.captureSources}}" wx:key="id" class="source-button" data-id="{{item.id}}" bindtap="openSource">{{item.primary ? '打开原始来源' : '打开关联来源'}}<text>{{item.date}} ›</text></button><text wx:if="{{!view.captureSources.length}}" class="place-note">暂无可打开的收录来源。</text></view>
      <view wx:if="{{view.notes.length}}" class="clues-section"><text class="section-title">记录中的线索</text><view wx:for="{{view.notes}}" wx:key="id" class="clue-card paper-card"><view class="clue-heading"><text>{{item.kind}}</text><text wx:if="{{item.inferred}}" class="inferred-tag">待核对推断</text></view><text class="clue-text">{{item.text}}</text></view></view>
      <view class="detail-actions"><button class="secondary-button" bindtap="edit" disabled="{{busy}}">补充想法</button><button wx:if="{{detail.status === 'ACTIVE'}}" class="primary-button" bindtap="markHappened" disabled="{{busy}}">移至已经发生</button></view>
      <view class="preference-row"><button class="preference-button {{myRating === 'LIKE' ? 'selected' : ''}}" wx:if="{{detail.status === 'ACTIVE' || detail.status === 'RESOLVED'}}" data-rating="LIKE" bindtap="rate" disabled="{{busy}}">{{myRating === 'LIKE' ? '♥ 已喜欢' : '♡ 喜欢'}}</button><button class="preference-button {{myRating === 'DISLIKE' ? 'selected' : ''}}" wx:if="{{detail.status === 'ACTIVE' || detail.status === 'RESOLVED'}}" data-rating="DISLIKE" bindtap="rate" disabled="{{busy}}">{{myRating === 'DISLIKE' ? '已不喜欢' : '不喜欢'}}</button><button class="delete-button" bindtap="remove" disabled="{{busy}}">删除记录</button></view>
      <view wx:if="{{reminderDeliveryAvailable && view.remindAt}}" class="capability-panel"><button class="secondary-button" bindtap="remind" disabled="{{busy}}">申请时间提醒</button></view>
    </block>
  </view>
</view>
<view wx:if="{{editing}}" class="sheet-overlay"><view class="editing-sheet"><view class="sheet-heading"><text class="section-title">编辑生活记录</text><button class="icon-button" bindtap="closeEdit" disabled="{{busy}}" aria-label="关闭编辑">×</button></view><scroll-view scroll-y class="sheet-content"><text class="field-label">标题</text><input class="editor-input" value="{{draftTitle}}" disabled="{{busy}}" maxlength="240" bindinput="titleInput"/><text class="field-label">补充想法</text><textarea class="editor-textarea" value="{{draftSummary}}" disabled="{{busy}}" maxlength="1200" bindinput="summaryInput"/><text class="field-label">记录状态</text><picker range="{{statusOptions}}" value="{{statusIndex}}" disabled="{{busy}}" bindchange="statusChange"><view class="editor-input picker-value">{{statusOptions[statusIndex]}} ⌄</view></picker><text wx:if="{{error}}" class="form-error">{{error}}</text></scroll-view><button class="primary-button" bindtap="saveEdit" disabled="{{busy}}">{{busy ? '保存中…' : '保存修改'}}</button></view></view>
<view wx:if="{{sourceOpen}}" class="sheet-overlay"><view class="editing-sheet"><view class="sheet-heading"><text class="section-title">{{sourceTitle || '收录来源'}}</text><button class="icon-button" bindtap="closeSource" aria-label="关闭来源">×</button></view><scroll-view scroll-y class="sheet-content"><text wx:if="{{sourceLoading}}" class="page-message">正在读取来源…</text><text wx:if="{{sourceError}}" class="form-error">{{sourceError}}</text><image wx:if="{{sourceImagePath}}" class="source-image" src="{{sourceImagePath}}" mode="widthFix" bindtap="previewSource"/><text class="source-text" user-select>{{sourceText}}</text></scroll-view></view></view>
<view wx:if="{{storeEditing}}" class="sheet-overlay"><view class="editing-sheet store-sheet"><view class="sheet-heading"><text class="section-title">适用门店核对</text><button class="icon-button" bindtap="closeStore" disabled="{{busy}}" aria-label="关闭门店核对">×</button></view><text class="store-note">请输入原券上写明的门店。核验服务尚未接入，当前不会将输入当作已确认的适用门店。</text><input class="editor-input" placeholder="原券门店名称或地址" value="{{storeQuery}}" disabled="{{busy}}" maxlength="240" bindinput="storeInput"/><text wx:if="{{error}}" class="form-error">{{error}}</text><button wx:if="{{ticketVerificationAvailable}}" class="primary-button" bindtap="verifyTicket" disabled="{{busy}}">查询核验服务</button></view></view>
