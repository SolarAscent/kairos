.profile-screen { height: 100vh; display: flex; flex-direction: column; }
.profile-header { width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx 20rpx; }
.back-button { width: 120rpx !important; flex-shrink: 0; margin: 0 !important; padding: 0 !important; line-height: 76rpx; text-align: left; font-size: 28rpx; color: #8B7564; }
.page-title { font-size: 30rpx; font-weight: 600; }
.header-spacer { width: 120rpx; }
.profile-scroll { flex: 1; height: 0; }
.profile-body { padding: 0 40rpx 32rpx; }
.identity-card { display: flex; flex-direction: column; align-items: center; padding: 30rpx 0 44rpx; }
.avatar-button { position: relative; width: 164rpx !important; height: 164rpx; margin: 0 !important; padding: 0 !important; overflow: visible; border-radius: 50%; }
.avatar-image, .avatar-default { width: 164rpx; height: 164rpx; border-radius: 50%; }
.avatar-default { background: #EBDDCD; display: flex; align-items: center; justify-content: center; }
.avatar-default text {  font-size: 86rpx; line-height: 1; }
.avatar-edit { position: absolute; bottom: 0; right: 0; width: 46rpx; height: 46rpx; border-radius: 50%; background: #A95F3F; color: #FFFDF8; border: 4rpx solid #FAF5ED; font-size: 30rpx; line-height: 38rpx; text-align: center; }
.display-name {  font-size: 42rpx; line-height: 1.5; font-weight: 500; margin-top: 24rpx; text-align: center; word-break: break-all; }
.avatar-hint { font-size: 28rpx; color: #8B7564; margin-top: 12rpx; }
.remove-avatar { color: #8B7564; font-size: 28rpx; line-height: 68rpx; margin: 4rpx 0 0; }
.form-card, .account-card { background: #FFFDF8; border-radius: 28rpx; padding: 0 30rpx; }
.form-field { padding: 28rpx 0; }
.field-label { font-size: 28rpx; font-weight: 600; }
.nickname-input { width: 100%; height: 76rpx; font-size: 32rpx; margin-top: 8rpx; }
.field-hint { color: #8B7564; font-size: 28rpx; line-height: 1.7; }
.field-divider { height: 2rpx; background: #EBDDCD; }
.field-heading { display: flex; align-items: center; justify-content: space-between; }
.optional, .field-count { color: #8B7564; font-size: 28rpx; }
.bio-input { width: 100%; height: 160rpx; line-height: 1.8; font-size: 28rpx; margin-top: 22rpx; }
.field-count { text-align: right; margin-top: 8rpx; }
.section-caption { font-size: 28rpx; color: #8B7564; margin: 36rpx 8rpx 18rpx; }
.account-card { padding: 30rpx; }
.account-heading { display: flex; align-items: center; }
.identity-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #9BAAA1; margin-right: 14rpx; }
.identity-dot.linked { background: #4C8066; }
.account-title { font-size: 28rpx; font-weight: 500; }
.account-detail { font-size: 28rpx; color: #8B7564; line-height: 1.8; margin-top: 14rpx; }
.account-id { width: 100% !important; display: flex; align-items: center; justify-content: space-between; text-align: left; margin: 24rpx 0 0 !important; padding-top: 22rpx; border-top: 2rpx solid #EBDDCD; line-height: 1.5; }
.id-label { font-size: 28rpx; color: #8B7564; }
.id-value {  font-size: 28rpx; margin-top: 10rpx; word-break: break-all; }
.copy-label { flex-shrink: 0; font-size: 28rpx; padding-left: 14rpx; }
.joined-date { font-size: 28rpx; color: #8B7564; margin-top: 20rpx; }
.privacy-note { padding: 28rpx 8rpx 8rpx; color: #8B7564; font-size: 28rpx; line-height: 1.9; }
.logout-button { margin: 12rpx auto 0; font-size: 28rpx; line-height: 88rpx; color: #8B7564; }
.save-area { background: #FAF5ED; padding: 20rpx 40rpx 0; }
.save-button { width: 100% !important; margin: 0 !important; border-radius: 48rpx; line-height: 92rpx; font-size: 30rpx; background: #A95F3F; color: #FFFDF8; }
.save-disabled { background: #EBDDCD; color: #8B7564; opacity: 1; }
.error { color: #925344; font-size: 28rpx; line-height: 1.7; padding-top: 16rpx; }
.save-error { padding: 0 8rpx 16rpx; }
.save-notice { font-size: 28rpx; color: #4C8066; text-align: center; padding-bottom: 16rpx; }
.load-state { text-align: center; color: #8B7564; padding: 140rpx 20rpx; line-height: 1.8; }
.retry-button { color: #A95F3F; font-size: 28rpx; line-height: 88rpx; margin-top: 28rpx; }
