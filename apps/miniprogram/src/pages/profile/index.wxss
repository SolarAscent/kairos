.profile-screen {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf5ed;
  color: #2c1b14;
}
.profile-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 38rpx 20rpx;
  border-bottom: 1rpx solid #e5d7c5;
}
.back-button {
  width: 120rpx !important;
  flex-shrink: 0;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 88rpx;
  text-align: left;
  font-size: 28rpx;
  color: #9c4a1a;
}
.page-title { font-size: 44rpx; font-weight: 650; }
.header-spacer { width: 120rpx; }
.profile-scroll { flex: 1; height: 0; }
.profile-body { padding: 0 38rpx 32rpx; }
.identity-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 0 44rpx;
}
.avatar-button {
  position: relative;
  width: 164rpx !important;
  height: 164rpx;
  margin: 0 !important;
  padding: 0 !important;
  overflow: visible;
  border-radius: 50%;
}
.avatar-image, .avatar-default { width: 164rpx; height: 164rpx; border-radius: 50%; }
.avatar-default {
  background: #f2e8d7;
  color: #9c4a1a;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-default text { font-size: 86rpx; line-height: 1; }
.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #9c4a1a;
  color: #fffdf9;
  border: 4rpx solid #faf5ed;
  font-size: 30rpx;
  line-height: 38rpx;
  text-align: center;
}
.display-name {
  font-size: 42rpx;
  line-height: 1.5;
  font-weight: 600;
  margin-top: 24rpx;
  text-align: center;
  word-break: break-all;
}
.avatar-hint, .remove-avatar {
  font-size: 28rpx;
  line-height: 1.6;
  color: #806658;
}
.avatar-hint { margin-top: 12rpx; }
.remove-avatar { margin: 8rpx 0 0; padding: 12rpx; }
.form-card, .account-card {
  background: #fffdf9;
  border: 1rpx solid #eadecf;
  border-radius: 18rpx;
  padding: 0 30rpx;
}
.form-field { padding: 28rpx 0; }
.field-label { font-size: 30rpx; font-weight: 600; }
.nickname-input { width: 100%; height: 76rpx; font-size: 32rpx; margin-top: 8rpx; }
.field-hint { color: #806658; font-size: 28rpx; line-height: 1.7; }
.field-divider { height: 2rpx; background: #eadecf; }
.field-heading { display: flex; align-items: center; justify-content: space-between; }
.optional, .field-count { color: #806658; font-size: 28rpx; }
.bio-input { width: 100%; height: 160rpx; line-height: 1.8; font-size: 30rpx; margin-top: 22rpx; }
.field-count { text-align: right; margin-top: 8rpx; }
.section-caption { font-size: 30rpx; color: #806658; margin: 36rpx 8rpx 18rpx; }
.account-card { padding: 30rpx; }
.account-heading { display: flex; align-items: center; }
.identity-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #b79a85; margin-right: 14rpx; }
.identity-dot.linked { background: #9c4a1a; }
.account-title { font-size: 30rpx; font-weight: 600; }
.account-detail { font-size: 28rpx; color: #806658; line-height: 1.8; margin-top: 14rpx; }
.account-id {
  width: 100% !important;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  margin: 24rpx 0 0 !important;
  padding-top: 22rpx;
  border-top: 2rpx solid #eadecf;
  line-height: 1.5;
}
.id-label, .copy-label { font-size: 28rpx; color: #806658; }
.id-value { font-size: 28rpx; margin-top: 10rpx; word-break: break-all; }
.copy-label { flex-shrink: 0; padding-left: 14rpx; color: #9c4a1a; }
.joined-date { font-size: 28rpx; color: #806658; margin-top: 20rpx; }
.privacy-note { padding: 28rpx 8rpx 8rpx; color: #806658; font-size: 28rpx; line-height: 1.9; }
.logout-button { margin: 12rpx auto 0; font-size: 28rpx; line-height: 88rpx; color: #9c4a1a; }
.save-area { background: #faf5ed; padding: 20rpx 38rpx 0; }
.save-button {
  width: 100% !important;
  margin: 0 !important;
  border-radius: 18rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #9c4a1a;
  color: #fffdf9;
}
.save-disabled { background: #dfceb5; color: #806658; opacity: 1; }
.error { color: #a13e35; font-size: 28rpx; line-height: 1.7; padding-top: 16rpx; }
.save-error { padding: 0 8rpx 16rpx; }
.save-notice { font-size: 28rpx; color: #9c4a1a; text-align: center; padding-bottom: 16rpx; }
.load-state { text-align: center; color: #806658; padding: 140rpx 20rpx; line-height: 1.8; font-size: 30rpx; }
.retry-button { color: #9c4a1a; font-size: 30rpx; line-height: 88rpx; margin-top: 28rpx; }
