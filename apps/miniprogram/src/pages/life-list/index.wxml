<view class="list-screen journal-page {{reduceMotion ? 'reduce-motion' : ''}}" style="padding-top: {{topInset}}px; padding-bottom: {{bottomInset}}px;">
  <view class="list-header"><button class="back" bindtap="goBack" aria-label="返回">‹</button><text class="page-title list-title">{{title}}</text><button class="refresh" bindtap="refresh" disabled="{{loading || locating}}" aria-label="更新列表">↻</button></view>
  <view class="search-row"><view class="search-box"><text class="search-icon">⌕</text><input value="{{searchDraft}}" placeholder="搜索自己的生活记录" maxlength="120" confirm-type="search" bindinput="searchInput" bindconfirm="submitSearch"/><button wx:if="{{searchDraft}}" class="clear-search" bindtap="clearSearch" aria-label="清除搜索">×</button></view><button class="search-submit" bindtap="submitSearch">搜索</button></view>
  <scroll-view scroll-x class="kind-scroll"><view class="kind-chips"><button wx:for="{{kindChips}}" wx:key="index" class="kind-chip {{kindIndex === item.index ? 'selected' : ''}}" data-index="{{item.index}}" bindtap="selectKind">{{item.label}}</button></view></scroll-view>
  <view class="filters"><picker range="{{timeOptions}}" value="{{timeIndex}}" bindchange="setTime" disabled="{{locating}}"><view class="filter">{{timeOptions[timeIndex]}} ⌄</view></picker><picker range="{{locationOptions}}" value="{{locationIndex}}" bindchange="setLocation" disabled="{{locating}}"><view class="filter">{{locating ? '获取位置中…' : locationOptions[locationIndex] + ' ⌄'}}</view></picker></view>
  <text wx:if="{{locationIndex >= 3}}" class="location-note">附近范围按上次获取的位置与已记录坐标估算直线距离。</text>
  <text wx:if="{{query && loaded}}" class="search-context">关于「{{query}}」已找到 {{items.length}} 条记录{{nextCursor ? '，可继续查看' : ''}}</text>
  <text wx:if="{{error}}" class="list-error">{{error}}</text>
  <scroll-view class="list-content" scroll-y type="list" bindscrolltolower="loadMore" lower-threshold="120"><view class="list-body">
    <view wx:if="{{!loggedIn}}" class="empty-panel paper-card"><text>登录后查看你留下的生活记录。</text><button class="primary-button" bindtap="login">去登录</button></view>
    <view wx:for="{{items}}" wx:key="id" class="record-card paper-card {{item.kind === 'ASSET' ? 'ticket-card' : ''}}">
      <view class="tape" aria-hidden="true"></view>
      <view class="record-content" data-id="{{item.id}}" bindtap="viewLifeItem" role="button" aria-label="查看{{item.title}}详情"><image wx:if="{{item.imagePath}}" class="record-image" src="{{item.imagePath}}" mode="aspectFill" data-image-id="{{item.imageCaptureId}}" binderror="imageLoadError" lazy-load /><button wx:elif="{{item.imageCaptureId && item.imageFailed}}" class="image-retry" data-image-id="{{item.imageCaptureId}}" catchtap="retryImage">图片暂未加载，点此重试</button><view wx:elif="{{item.imageCaptureId}}" class="image-loading">正在加载图片…</view><view class="record-top"><text class="record-kind">{{item.kindLabel}}{{item.status === 'RESOLVED' ? ' · 已经发生' : ''}}</text><text wx:if="{{item.expiryDate}}" class="date-stamp">有效至 {{item.expiryDate}}</text><text wx:elif="{{item.nextDate}}" class="date-stamp">{{item.nextDate}}</text></view><text class="record-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="record-summary">{{item.summary}}</text><view class="record-bottom"><text class="record-meta">{{item.locationLabel || ('留下于 ' + item.savedDate)}}</text><text class="open-detail">查看{{item.kind === 'ASSET' ? '原券' : '详情'}} ›</text></view></view>
      <view class="record-ratings"><button class="rating-button {{item.myRating === 'LIKE' ? 'rated-like' : ''}}" data-id="{{item.id}}" data-rating="LIKE" bindtap="rateLifeItem" disabled="{{ratingBusy.length > 0}}">{{item.myRating === 'LIKE' ? '♥ 已喜欢' : '♡ 喜欢'}}</button><button class="rating-button {{item.myRating === 'DISLIKE' ? 'rated-dislike' : ''}}" data-id="{{item.id}}" data-rating="DISLIKE" bindtap="rateLifeItem" disabled="{{ratingBusy.length > 0}}">{{item.myRating === 'DISLIKE' ? '已不喜欢' : '不喜欢'}}</button></view>
    </view>
    <view wx:if="{{loggedIn && loaded && !items.length}}" class="empty-panel paper-card"><text class="empty-title">未找到相关生活记录</text><text>{{query ? '换个词试试，或清除关键词。' : '试试其他时间或地点范围。'}}</text><button wx:if="{{query}}" class="secondary-button" bindtap="clearSearch">清除关键词</button></view>
    <text wx:if="{{loading}}" class="list-status">正在查看…</text><button wx:elif="{{nextCursor}}" class="more secondary-button" bindtap="loadMore">继续查看</button><text wx:elif="{{loaded && items.length}}" class="list-status">已展示这些筛选条件下的全部记录</text><button wx:if="{{error && loggedIn}}" class="more secondary-button" bindtap="retry">重试</button>
  </view></scroll-view>
</view>
