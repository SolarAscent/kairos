.list-screen { height: 100vh; display: flex; flex-direction: column; }
.list-header { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; }
.back, .refresh { font-size: 27rpx; color: #72827B; line-height: 64rpx; padding: 0 12rpx; }
.list-title { font-family: 'Songti SC', serif; font-size: 52rpx; margin: 28rpx 48rpx; }
.filters { display: flex; flex-wrap: wrap; padding: 0 40rpx 20rpx; }
.filter { background: #DEE7DF; border-radius: 24rpx; padding: 18rpx 22rpx; margin: 8rpx; font-size: 25rpx; }
.filter-label { font-size: 21rpx; color: #72827B; margin-bottom: 8rpx; }
.location-note { margin: 0 48rpx 20rpx; font-size: 23rpx; color: #72827B; line-height: 1.7; }
.list-content { flex: 1; height: 0; }
.list-body { padding: 8rpx 48rpx 40rpx; }
.object-card { background: #FFFFFF; border-radius: 28rpx; padding: 30rpx; margin-bottom: 24rpx; }
.kind { color: #72827B; font-size: 23rpx; margin-bottom: 14rpx; }
.object-title { font-size: 34rpx; line-height: 1.6; white-space: pre-wrap; }
.summary { font-size: 27rpx; color: #72827B; line-height: 1.8; margin-top: 20rpx; white-space: pre-wrap; }
.metadata { color: #72827B; font-size: 23rpx; line-height: 1.8; margin-top: 16rpx; }
.list-status, .empty-list { color: #72827B; text-align: center; font-size: 26rpx; line-height: 1.9; padding: 32rpx 0; }
.more { color: #233C35; background: #DEE7DF; border-radius: 40rpx; line-height: 80rpx; font-size: 27rpx; margin: 20rpx 0; }
.list-error { color: #925344; font-size: 26rpx; line-height: 1.8; margin: 0 48rpx 20rpx; }
