# Copy to .local/wechat-staging.env on the deployment host; chmod 600.
# These are Compose inputs, separate from the development .env.
KAIROS_IMAGE=kairos-staging:release-REPLACE
# Generate independently with openssl rand -hex 32; use hex to keep the DB URL valid.
POSTGRES_PASSWORD=
JWT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
