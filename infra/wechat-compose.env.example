# Copy to .local/wechat-staging.env on the deployment host; chmod 600.
# These are Compose inputs, separate from the development .env.
KAIROS_IMAGE=kairos-staging:release-REPLACE
# Generate independently with openssl rand -hex 32; use hex to keep the DB URL valid.
POSTGRES_PASSWORD=
JWT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Keep mock explicit until credentials are available; API capabilities report it.
MODEL_PROVIDER=mock
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
QWEN_TEXT_MODEL=qwen3.7-flash-2026-07-15
QWEN_VISION_MODEL=qwen3.7-flash-2026-07-15
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
GLM_API_KEY=
GLM_TEXT_MODEL=glm-4.7-flash
GLM_VISION_MODEL=glm-4.6v-flash

# Optional Tencent LBS; unavailable routes fall back to preparation actions.
TENCENT_LBS_KEY=
TENCENT_LBS_SECRET=
