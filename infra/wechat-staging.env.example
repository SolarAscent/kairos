# Inject real values through the server's secret manager; never copy this into client source.
NODE_ENV=production
PORT=3000
DATABASE_URL=
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=1200
REFRESH_TOKEN_TTL_DAYS=30
WECHAT_MOCK_LOGIN=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Controlled functional staging only. Select/evaluate a real model before real-user testing.
MODEL_PROVIDER=mock
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
QWEN_TEXT_MODEL=qwen3.7-flash-2026-07-15
QWEN_VISION_MODEL=qwen3.7-flash-2026-07-15
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
GLM_API_KEY=
GLM_TEXT_MODEL=glm-4.7-flash
GLM_VISION_MODEL=glm-4.6v-flash
DEMO_ORIGIN=

# Optional Tencent LBS; unavailable routes fall back to preparation actions.
TENCENT_LBS_KEY=
TENCENT_LBS_SECRET=
